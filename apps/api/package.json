{
    "name": "@flight-planner/api",
    "version": "1.0.0",
    "scripts": {
        "dev": "pnpm env:load tsx watch src/http/server.ts",
        "env:load": "dotenv -e ../../.env --",
        "db:migrate": "pnpm env:load prisma migrate dev",
        "db:migrate-create-only": "pnpm env:load prisma migrate dev --create-only",
        "db:studio": "pnpm env:load prisma studio",
        "db:seed": "pnpm env:load prisma db seed",
        "db:reset": "pnpm env:load prisma migrate reset",
        "build": "tsup",
        "start": "node dist/http/server.js",
        "start:dev": "pnpm env:load node dist/http/server.js"
    },
    "dependencies": {
        "@casl/ability": "^6.7.3",
        "@fastify/cors": "^11.1.0",
        "@fastify/jwt": "^10.0.0",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^5.2.3",
        "@flight-planner/auth": "workspace:*",
        "@flight-planner/env": "workspace:*",
        "bcryptjs": "^3.0.2",
        "fastify": "^5.5.0",
        "fastify-plugin": "^5.0.1",
        "fastify-type-provider-zod": "^6.0.0",
        "immer": "^11.1.4",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@flight-planner/eslint-config": "workspace:*",
        "@flight-planner/prettier": "workspace:*",
        "@flight-planner/tsconfig": "workspace:*",
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "^22.15.3",
        "dotenv-cli": "^10.0.0",
        "tsup": "^8.5.0",
        "tsx": "^4.20.5"
    },
    "prettier": "@flight-planner/prettier",
    "eslintConfig": {
        "extends": [
            "@flight-planner/eslint-config/node"
        ]
    }
}
